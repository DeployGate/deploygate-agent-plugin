{
  "name": "deploygate-agent-plugin",
  "version": "1.4.0",
  "description": "DeployGate agent integration: upload mobile apps, manage distribution pages, set up CI/CD, and onboard your team. Supports iOS (IPA) and Android (APK/AAB).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "deploygate-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "tsc && node scripts/build-bundle.mjs",
    "prepare": "tsc && (git config core.hooksPath .githooks || true)",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "plugin/",
    ".agents/",
    ".claude-plugin/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "DeployGate",
    "email": "support@deploygate.com"
  },
  "homepage": "https://github.com/DeployGate/deploygate-agent-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeployGate/deploygate-agent-plugin.git"
  }
}
