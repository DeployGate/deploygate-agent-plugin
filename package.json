{
  "name": "deploygate-claude-plugin",
  "version": "1.2.0",
  "description": "DeployGate integration for Claude Code — upload mobile apps, manage distribution pages, set up CI/CD, and onboard your team. Supports iOS (IPA) and Android (APK/AAB).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "deploygate-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && esbuild dist/index.js --bundle --platform=node --format=esm --outfile=plugin/scripts/bundle.js",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "plugin/",
    ".claude-plugin/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "DeployGate",
    "email": "support@deploygate.com"
  },
  "homepage": "https://github.com/DeployGate/deploygate-claude-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeployGate/deploygate-claude-plugin.git"
  }
}
