{
  "name": "@deploygate/mcp",
  "version": "1.3.1",
  "description": "DeployGate MCP server: upload mobile apps, manage distribution pages, set up CI/CD, and onboard your team. Supports iOS (IPA) and Android (APK/AAB).",
  "type": "module",
  "bin": {
    "deploygate-mcp": "plugin/scripts/bundle.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "tsc && node scripts/build-bundle.mjs",
    "prepare": "tsc && (git config core.hooksPath .githooks || true)",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "plugin/scripts/bundle.js",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "DeployGate",
    "email": "support@deploygate.com"
  },
  "homepage": "https://github.com/DeployGate/deploygate-agent-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeployGate/deploygate-agent-plugin.git"
  }
}
